{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build",
            "type": "shell",
            "command": "make",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Clean",
            "type": "shell",
            "command": "make clean",
            "problemMatcher": []
        },
        {
            "label": "Configure Steinzeit",
            "type": "shell",
            "command": "cp configs/steinzeit.config .config && make olddefconfig",
            "problemMatcher": []
        }
    ]
}
